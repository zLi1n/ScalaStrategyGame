<AnchorPane prefHeight="720.0" prefWidth="1080.0" styleClass="root" stylesheets="@baseStyle.css,@storyStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="planetgame.view.StoryController">
   <VBox alignment="CENTER" layoutX="328.79998779296875" layoutY="86.4000015258789" AnchorPane.bottomAnchor="228.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
      <children>
          <ImageView fx:id="characterImage" fitHeight="405.0" fitWidth="450.0" preserveRatio="true">
            <image>
               <Image url="@../../images/character.png" />
            </image>
         </ImageView>
      </children>
   </VBox>
    <VBox fx:id="dialogBox" alignment="CENTER_LEFT" prefHeight="251.0" prefWidth="1080.0" spacing="10" styleClass="dialog-box" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <children>
            <Label fx:id="storyText" prefHeight="117.0" prefWidth="1030.0" styleClass="story-text" text="Long ago, this planet was full of hope..." wrapText="true" />
         <VBox alignment="BOTTOM_RIGHT" prefHeight="37.0" prefWidth="1040.0" AnchorPane.rightAnchor="20.0">
            <children>
               <ButtonBar>
                  <buttons>
                        <Button fx:id="nextButton" alignment="CENTER_RIGHT" onAction="#handleNext" prefHeight="38.0" prefWidth="170.0" styleClass="next-button" text="Next →">
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor>
                     </Button>
                  </buttons>
               </ButtonBar>
            </children>
         </VBox>
        </children>
    </VBox>
    <Label fx:id="characterName" layoutX="16.0" layoutY="435.0" styleClass="character-name" text="Elder Solari" AnchorPane.bottomAnchor="226.6" AnchorPane.leftAnchor="20.0" />
</AnchorPane>
