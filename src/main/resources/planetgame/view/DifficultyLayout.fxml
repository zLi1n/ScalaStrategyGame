<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="homeRoot" prefHeight="720.0" prefWidth="1080.0" styleClass="root" stylesheets="@baseStyle.css,@homeStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="planetgame.view.DifficultyController">
    <children>
        <HBox alignment="CENTER" prefHeight="720.0" prefWidth="1080.0" spacing="60.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox fx:id="easyBox" alignment="CENTER" spacing="10.0">
                    <ImageView fx:id="easyPlanet" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/kenney_planets/Planets/planet03.png" />
                  </image>
               </ImageView>
                    <Label styleClass="planet-name" text="Gaialuna" />
                    <Label styleClass="difficulty-stars" text="Difficulty: ★☆☆" />
                    <Button onAction="#handleSelectEasy" text="Select ✓">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
                  <graphic>
                     <ImageView fitHeight="28.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true" visible="false">
                        <image>
                           <Image url="@../../images/icons/lock.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
                </VBox>
                <VBox fx:id="mediumBox" alignment="CENTER" spacing="10.0">
                    <ImageView fx:id="mediumPlanet" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/kenney_planets/Planets/planet01.png" />
                  </image>
               </ImageView>
                    <Label styleClass="planet-name" text="Pyronox" />
                    <Label styleClass="difficulty-stars" text="Difficulty: ★★☆" />
                    <Button onAction="#handleSelectMedium" text="Select  ✓">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
                  <graphic>
                     <ImageView fx:id="mediumLock" fitHeight="28.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../../images/icons/lock.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
                </VBox>
                <VBox fx:id="hardBox" alignment="CENTER" spacing="10.0">
                    <ImageView fx:id="hardPlanet" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/kenney_planets/Planets/planet08.png" />
                  </image>
               </ImageView>
                    <Label styleClass="planet-name" text="Xeravon" />
                    <Label styleClass="difficulty-stars" text="Difficulty: ★★★" />
                    <Button onAction="#handleSelectHard" text="Select  ✓">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
                  <graphic>
                     <ImageView fx:id="hardLock" fitHeight="28.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../../images/icons/lock.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
